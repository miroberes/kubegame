lookaround() {
  local ns pods services namespaces name phase svc ips
  ns=$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)
  ns=${ns:-default}
  pods=$(kubectl get pods -l listed-in="$ns" -o go-template='{{range .items}}{{.metadata.name}} {{.status.phase}}{{"\n"}}{{end}}')
  services=$(kubectl get services -l listed-in="$ns" -o go-template='{{range .items}}{{.metadata.name}}{{"\n"}}{{end}}')
  namespaces=$(kubectl get namespaces -l listed-in="$ns" -o go-template='{{range .items}}{{.metadata.name}}{{"\n"}}{{end}}' 2>/dev/null)
  {
    echo "$ns"
    while read -r name; do
      [ -n "$name" ] && echo "$name"
    done <<<"$namespaces"
    while read -r name phase; do
      [ -n "$name" ] || continue
      if [ "$phase" = Running ]; then echo "$name"; else echo "$name error"; fi
    done <<<"$pods"
    while read -r svc; do
      [ -n "$svc" ] || continue
      ips=$(kubectl get endpoints "$svc" -o jsonpath='{.subsets[*].addresses[*].ip}' 2>/dev/null)
      if [ -n "$ips" ]; then echo "$svc"; else echo "$svc error"; fi
    done <<<"$services"
  } | awk '{ if (NF > 1) err[$1] = 1; seen[$1] = 1 } END { for (n in seen) printf "  %s%s\n", n, (err[n] ? "  error" : "") }' | sort
}
_kingdom_describe lookaround "default" "list the pods and services you can see"
inspect() {
  if [ -z "$1" ]; then
    echo "usage: inspect <name>" >&2
    return 1
  fi
  local out
  if out=$(kubectl logs -c cluelogger "$1" 2>/dev/null); then
    printf '%s\n' "$out"
  elif kubectl get namespace "$1" >/dev/null 2>&1; then
    local cur
    cur=$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)
    if [ "$cur" = "$1" ]; then
      describe "$1"
    else
      echo "To inspect the $1 you need to enter it."
      return 1
    fi
  else
    echo "There is nothing called $1 here."
    return 1
  fi
}
_kingdom_describe inspect "default village" "read a pod's clue log"
_kingdom_describe clue "default" "ask for a hint"
_kingdom_describe switch "default village" "switch to another namespace, e.g. switch village"
switch() {
  kubectl get namespace "$1" >/dev/null || return 1
  kubectl config set-context --current --namespace="$1" >/dev/null
}
alias openk8s='kubectl exec gate -c cluelogger -- sh -c "sh /scripts/check_phrase.sh openk8s && { /tools/kubectl get rolebinding act2-player -n village >/dev/null 2>&1 || /tools/kubectl create rolebinding act2-player --role=act2-player --serviceaccount=default:player -n village >/dev/null; } && /tools/kubectl patch configmap kingdom-state -n default --type merge -p '\''{\"data\":{\"act\":\"2\"}}'\'' >/dev/null"'
alias clue='kubectl exec gate -c cluelogger -- wget -q -O - http://clue'
describe() {
  if [ -z "$1" ]; then
    echo "usage: describe <name>" >&2
    return 1
  fi
  local desc
  if desc=$(kubectl get pod "$1" -o jsonpath='{.metadata.annotations.description}' 2>/dev/null); then
    :
  elif desc=$(kubectl get service "$1" -o jsonpath='{.metadata.annotations.description}' 2>/dev/null); then
    :
  elif desc=$(kubectl get namespace "$1" -o jsonpath='{.metadata.annotations.description}' 2>/dev/null); then
    local cur outside
    cur=$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)
    if [ "$cur" != "$1" ]; then
      outside=$(kubectl get namespace "$1" -o jsonpath='{.metadata.annotations.outside-description}' 2>/dev/null)
      desc=${outside:-$desc}
    fi
  else
    echo "There is nothing called $1 here."
    return 1
  fi
  echo "${desc:-Nothing special about it.}"
}
_kingdom_describe describe "default village" "describe a pod or service you can see, e.g. describe gate"
