alias call='kubectl exec player-pod -- wget -q -O -'
dial() {
  case "$1" in
    [0-9]*) set -- "booth-telephone:$1" "${@:2}" ;;
  esac
  case "$1" in
    booth-telephone|booth-telephone:*) ;;
    '') echo "usage: dial booth-telephone:<port> [name]" >&2; return 1 ;;
    *) echo "There is nothing called $1 here." >&2; return 1 ;;
  esac
  if [ -n "$2" ]; then
    kubectl exec player-pod -- wget -q -O - --post-data="$2" "http://$1/cgi-bin/message"
  else
    kubectl exec player-pod -- wget -q -O - "$1"
  fi
}
_kingdom_describe call "village" "call a service from your player-pod, e.g. call chimneysweep"
_kingdom_describe dial "telephone-booth" "dial a number on the phone, e.g. dial XXXX"

enter() {
  if [ -z "$1" ]; then
    echo "usage: enter <namespace>" >&2
    return 1
  fi
  kubectl get namespace "$1" >/dev/null || return 1
  if [ "$1" = wizardshouse ]; then
    local name=${2:-} heard
    if [ -z "$name" ]; then read -r -p "Name: " name; fi
    heard=$(kubectl exec player-pod -- wget -q -O - http://wizards-phone.wizardshouse:8081/cgi-bin/message 2>/dev/null)
    if [ "$heard" != "I remember: $name" ] || ! kubectl auth can-i create pods -n "$1" >/dev/null 2>&1; then
      echo "The wizard has not let you in yet."
      return 1
    fi
  fi
  kubectl run player-pod --namespace="$1" --image=curlimages/curl --image-pull-policy=IfNotPresent --command -- sh -c "sleep infinity" >/dev/null || return 1
  for _ in $(seq 60); do
    [ "$(kubectl get pod player-pod --namespace="$1" -o jsonpath='{.status.phase}' 2>/dev/null)" = Running ] && break
    sleep 1
  done
  switch "$1" || return 1
  echo "You entered the $1, look around..."
}
_kingdom_describe enter "village" "enter a namespace: creates your player-pod there and switches to it, e.g. enter village"
